# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://mikan:mikan@localhost:5432/mikan

# REQUIRED in production — the app refuses to start on the default.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# Access tokens are short because /auth/refresh renews them silently.
# Shorten this and a stolen token expires sooner; the refresh cookie
# still gives a 30-day session, and deactivating an account ends it at
# the next renewal.
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# Where reset links and email buttons point. REQUIRED in production —
# the app refuses to start if this still says localhost.
WEB_BASE_URL=http://localhost:5188

# Comma-separated. Must list the exact Vercel origin(s), including any
# preview domains that need to reach the API.
CORS_ORIGINS=http://localhost:5188

# Login attempts per IP per window, across all accounts. The per-account
# lockout (5 tries, 15 min) handles guessing one password; this handles
# one address trying one guess against many accounts.
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=300

# How long an emailed reset link stays usable.
RESET_TOKEN_MINUTES=60

# "production" turns on secure cookies, SameSite=None for cross-origin
# requests, hides /docs, and enforces the two checks above.
ENVIRONMENT=development
